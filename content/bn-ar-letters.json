      "tips": [
        {
          "title": "নুকতা দিয়ে হরফ চেনো",
          "body": "অনেক হরফের আকার একই, শুধু নুকতা (ফোঁটা) আলাদা: ب নিচে এক নুকতা, ت উপরে দুই, ث উপরে তিন, ن উপরে এক। নুকতা গুনলেই হরফ চেনা যায়।",
          "examples": [
            "ب ت ث ن",
            "ج ح خ"
          ]
        },
        {
          "title": "হরকত: যবর, যের, পেশ",
          "body": "হরফের উপরে-নিচে ছোট চিহ্ন উচ্চারণ বলে দেয়: যবর ( َ ) = আ, যের ( ِ ) = ই, পেশ ( ُ ) = উ, সুকুন ( ْ ) = থামো। بَ = বা, بِ = বি, بُ = বু, بْ = ব্।",
          "examples": [
            "بَ بِ بُ",
            "بَاب"
          ]
        },
        {
          "title": "হাযা আর হাযিহি",
          "body": "هَذَا (হাযা) = এটা (ছেলে-জাতীয় জিনিস), هَذِهِ (হাযিহি) = এটা (মেয়ে-জাতীয়)। এই দুটো শব্দ আগে থেকে চিনে রাখো, প্রায় প্রতিটা বাক্যে আসবে।",
          "examples": [
            "هَذَا بَيْت",
            "هَذِهِ بِنْت"
          ]
        }
